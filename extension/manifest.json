{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.3.0",
  "version_name": "1.3.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "offscreen",
    "clipboardWrite",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://pustaka.ut.ac.id/*",
    "https://community.bukabmp.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BMP Terbuka",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html?surface=sidepanel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pustaka.ut.ac.id/reader/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: https://community.bukabmp.workers.dev https://pustaka.ut.ac.id; img-src 'self' data: blob: https://community.bukabmp.workers.dev; media-src 'self' blob: https://community.bukabmp.workers.dev"
  },
  "default_locale": "id"
}
