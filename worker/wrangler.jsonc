{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "keep_vars": true,
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "PAIRINGS",
      "id": "873f03a3acf14ea18cc9b7b84eb8965f"
    }
  ],
  "d1_databases": [
    {
      "binding": "BOT_DB",
      "database_name": "bmp-terbuka-bot-v2",
      "database_id": "093f7e21-3eb9-4e08-bd50-3cb991067a07",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AD_MEDIA",
      "bucket_name": "bmp-terbuka-ad-media"
    }
  ],
  "vars": {
    "BOT_V2_D1_REPLAY_ENABLED": "true",
    "BOT_V2_SUPPORTER_D1_ENABLED": "true",
    "BOT_V2_PAYMENT_D1_ENABLED": "true",
    "BOT_V2_D1_MIGRATION_ENABLED": "false",
    "BOT_V2_REFERRAL_D1_ENABLED": "true",
    "BOT_V2_D1_WRITE_ENABLED": "false",
    "BOT_V2_REFERRAL_SELF_TEST_ENABLED": "false",
    "BOT_V2_ACTIVATION_LEDGER_ENABLED": "true",
    "BOT_V21_UI_CANARY_ENABLED": "false",
    "BOT_V21_UI_ENABLED": "true",
    "TELEGRAM_COMMAND_MENU_MODE": "minimal"
  }
}
